{
  "cli": {
    "version": ">= 19.0.8",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "env": {
        "APP_VERSION_IOS": "1.0.0",
        "APP_VERSION_ANDROID": "1.0.0"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "APP_VERSION_IOS": "1.0.0",
        "APP_VERSION_ANDROID": "1.0.0"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
